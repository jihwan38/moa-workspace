+// Exchange slice-low L%8 with the low three local-row bits. Each output
+// slice then owns eight contiguous BF16 rows, meeting TDMA gather alignment.
+fn restore_interleaved_rows(
+    device: &mut Device,
+    input: &DmTensor<bf16, Chip, UpGateCluster, UpGateSlices, m![L / 8 % 32]>,
+) -> DmTensor<bf16, Chip, UpGateCluster, m![L / 256 % 30 # 32, L / 8 % 8], m![L / 64 % 4, L % 8]> {
+    device.main.begin(input.view())
+        .fetch::<m![L / 64 % 4, L / 8 % 8], m![1 # 4]>()
+        .switch::<m![L / 256 % 30 # 32, L / 8 % 8], m![L / 64 % 4, L % 8]>(
+            SwitchConfig::InterTranspose { slice1: 8, slice0: 1, time0: 1 })
+        .collect::<m![L / 64 % 4, L % 8], m![1 # 16]>()
+        .transpose::<m![L / 64 % 4, L / 4 % 2], m![L % 4 # 16]>()
+        .commit_trim::<m![L % 4]>().commit()
 }
 
