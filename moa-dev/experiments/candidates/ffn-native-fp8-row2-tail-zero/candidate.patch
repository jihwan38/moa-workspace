 fn compact_full256_rows(
     device: &mut Device,
     x: &DmTensor<bf16, Chip, UpGateCluster, UpGateSlices, m![FfnRow]>,
-) -> DmTensor<bf16, Chip, UpGateCluster, Slice, m![FfnRow = 30, FfnSlice]> {
+) -> DmTensor<bf16, Chip, UpGateCluster, m![FfnSlice / 2, 1 # 2], m![FfnRow = 30, FfnSlice % 2]> {
