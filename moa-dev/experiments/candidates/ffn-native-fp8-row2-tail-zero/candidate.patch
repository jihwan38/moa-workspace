         .begin(x.view().tile::<m![FfnRow], 30, m![FfnRow = 30 # 32]>(0))
         .fetch::<m![FfnRow = 30], m![1 # 16]>()
-        .switch::<Slice, m![FfnRow = 30, FfnSlice]>(SwitchConfig::Broadcast1 { slice1: 256, slice0: 1 })
-        .collect::<m![FfnRow = 30, FfnSlice], m![1 # 16]>()
-        .transpose::<m![FfnRow = 30, FfnSlice / 4], m![FfnSlice % 4 # 16]>()
-        .commit_trim::<m![FfnSlice % 4]>()
+        .switch::<m![FfnSlice / 2, 1 # 2], m![FfnRow = 30, FfnSlice % 2]>(SwitchConfig::Broadcast1 { slice1: 2, slice0: 1 })
+        .collect::<m![FfnRow = 30, FfnSlice % 2], m![1 # 16]>()
+        .transpose::<m![FfnRow = 30 / 2], m![(FfnRow = 30 % 2, FfnSlice % 2) # 16]>()
+        .commit_trim::<m![FfnRow = 30 % 2, FfnSlice % 2]>()
         .commit()
 }
 
